opam-version: "2.0"
maintainer: "Jane Street developers"
authors: ["Jane Street Group, LLC"]
homepage: "https://github.com/janestreet/bonsai_term_devtools_kernel"
bug-reports: "https://github.com/janestreet/bonsai_term_devtools_kernel/issues"
dev-repo: "git+https://github.com/janestreet/bonsai_term_devtools_kernel.git"
doc: "https://ocaml.janestreet.com/ocaml-core/latest/doc/bonsai_term_devtools_kernel/index.html"
license: "MIT"
x-maintenance-intent: ["(latest)"]
build: [
  ["dune" "build" "-p" name "-j" jobs]
]
depends: [
  "ocaml" {>= "5.1.0"}
  "async"
  "bonsai"
  "bonsai_term"
  "bonsai_term_components"
  "core"
  "core_unix"
  "notty_async"
  "ppx_jane"
  "dune"                   {>= "3.17.0"}
]
available: arch != "x86_32"
conflicts: [
  "oxcaml-compiler" {< "5.2.0minus39"}
]
synopsis: "In-terminal developer tools for Bonsai_term applications"
description: "
Developer tools for inspecting and debugging Bonsai_term applications from within
     the terminal UI.
"
